<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CCVFS.MainWindow"
        Title="CCVFS — Зашифрованный контейнер"
        Width="700" Height="540"
        MinWidth="650" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ── Top panel ─────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="10"
              ColumnDefinitions="95,*,Auto"
              RowDefinitions="Auto,Auto,Auto,Auto">

            <Label Grid.Row="0" Grid.Column="0" Content="Папка:" VerticalAlignment="Center" />
            <TextBox x:Name="FolderBox" Grid.Row="0" Grid.Column="1" LostFocus="FolderBox_LostFocus" />
            <Button x:Name="BrowseFolderBtn" Grid.Row="0" Grid.Column="2" Content="..."
                    Width="40" Margin="8,0,0,0" VerticalAlignment="Stretch"
                    Click="BrowseFolder_Click" />

            <Label Grid.Row="1" Grid.Column="0" Content="Имя (.ccvfs):" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Width="220"
                     HorizontalAlignment="Left" Margin="0,8,0,0" />

            <Label Grid.Row="2" Grid.Column="0" Content="Пароль:" VerticalAlignment="Center" />
            <TextBox x:Name="PwdBox" Grid.Row="2" Grid.Column="1" Width="220"
                     HorizontalAlignment="Left" Margin="0,8,0,0" PasswordChar="●" />

            <CheckBox x:Name="KeyfileCheck" Grid.Row="3" Grid.Column="0" Content="Keyfile:"
                      VerticalAlignment="Center"
                      Checked="KeyfileCheck_Changed" Unchecked="KeyfileCheck_Changed" />
            <TextBox x:Name="KeyfileBox" Grid.Row="3" Grid.Column="1" IsEnabled="False"
                     Margin="0,8,0,0" />
            <Button x:Name="BrowseKeyfileBtn" Grid.Row="3" Grid.Column="2" Content="..."
                    Width="40" Margin="8,8,0,0" VerticalAlignment="Stretch" IsEnabled="False"
                    Click="BrowseKeyfile_Click" />
        </Grid>

        <!-- ── Center (file list) ────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="10,4,10,4" RowDefinitions="Auto,*">
            <Label Grid.Row="0" Content="Файлы в контейнере:" />
            <ListBox x:Name="FileList" Grid.Row="1" FontFamily="Consolas,Courier New" />
        </Grid>

        <!-- ── Bottom panel ──────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Margin="10">
            <StackPanel Orientation="Horizontal" Spacing="5">
                <Button x:Name="CreateBtn"    Content="Создать"   Width="88" Click="CreateBtn_Click" />
                <Button x:Name="OpenBtn"      Content="Открыть"   Width="88" Click="OpenBtn_Click" />
                <Button x:Name="AddBtn"       Content="Добавить"  Width="88" Click="AddBtn_Click" />
                <Button x:Name="ExtractBtn"   Content="Извлечь"   Width="88" Click="ExtractBtn_Click" />
                <Button x:Name="DeleteBtn"    Content="Удалить"   Width="88" Click="DeleteBtn_Click" />
                <Button x:Name="IntegrityBtn" Content="Проверить" Width="88" Click="IntegrityBtn_Click" />
            </StackPanel>

            <TextBlock x:Name="StatusLabel" Text="Готов." Margin="0,12,0,0" Height="22" />
            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" IsVisible="False"
                         Height="16" Margin="0,6,0,0" />
        </StackPanel>

    </Grid>
</Window>
